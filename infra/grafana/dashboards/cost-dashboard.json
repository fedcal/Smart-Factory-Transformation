            "axisLabel": "tokens/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(sft_agent_tokens_input_total[5m])",
          "legendFormat": "Input tokens {{agent_cluster}}",
          "refId": "A",
          "comment": "Requires sft_agent_tokens_input_total counter (BudgetSnapshot.tokens_input) pushed via Pushgateway."
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(events_published_total[5m]) * 500",
          "legendFormat": "{{subject}} (500-tok proxy)",
          "refId": "B",
          "comment": "Fallback: event rate * 500 tokens as proxy when Pushgateway metric absent."
        }
      ],
      "title": "Input Token Rate per Agent (tokens/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Output tokens per agent cluster. BudgetSnapshot.tokens_output from sft_agents/models/budget.py (D-60). Wire via Pushgateway with label agent_cluster.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "tokens/s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(sft_agent_tokens_output_total[5m])",
          "legendFormat": "Output tokens {{agent_cluster}}",
          "refId": "A",
          "comment": "Requires sft_agent_tokens_output_total counter (BudgetSnapshot.tokens_output) pushed via Pushgateway."
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(events_published_total[5m]) * 150",
          "legendFormat": "{{subject}} (150-tok proxy)",
          "refId": "B",
          "comment": "Fallback: event rate * 150 tokens as output proxy when Pushgateway metric absent."
        }
      ],
      "title": "Output Token Rate per Agent (tokens/s)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Total tokens consumed (input + output) per agent cluster — cumulative budget view. BudgetSnapshot.tokens_total from sft_agents/models/budget.py (D-60). Wire via Pushgateway.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50000 },
              { "color": "red", "value": 100000 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sft_agent_tokens_total or vector(0)",
          "legendFormat": "{{agent_cluster}} total tokens",
          "refId": "A",
          "comment": "Requires sft_agent_tokens_total gauge (BudgetSnapshot.tokens_total) pushed via Pushgateway."
        }
      ],
      "title": "Total Tokens Consumed per Agent Cluster (cumulative)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 102,
      "title": "Agent Latency Percentiles (OBS-07: p50 / p95 / p99)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Agent invocation latency p50/p95/p99 per job — cost efficiency view. High latency with low cost indicates slow model inference; high cost with low latency indicates expensive model. See also agent-kpis dashboard for standalone latency view.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Latency (s)",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.0 },
              { "color": "red", "value": 2.0 }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 23 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, job) (rate(ingest_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{job}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(ingest_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{job}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, job) (rate(ingest_latency_seconds_bucket[5m])))",
          "legendFormat": "p99 {{job}}",
          "refId": "C"
        }
      ],
      "title": "Agent Latency p50 / p95 / p99 per Job",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 103,
      "title": "Budget Limits vs Consumption (D-60)",
