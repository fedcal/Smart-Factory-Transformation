  "description": "Smart Factory Transformation — Cost Dashboard: simulated cost (BudgetSnapshot.cost_usd_simulated), token consumption per agent, latency p50/p95/p99 per agent (OBS-07). Budget model: sft_agents/models/budget.py.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Cost Overview — Simulated Cost per Agent (OBS-07)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Simulated cost (USD) — total across all agents. BudgetSnapshot.cost_usd_simulated from sft_agents/models/budget.py. Pricing is simulated (no real $/token mapping in Phase 4 PoC; Phase 11 wires real pricing). Wire via Pushgateway using the cost_usd_simulated field from BudgetSnapshot.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 4,
          "mappings": [
            { "options": { "0": { "color": "green", "index": 0, "text": "$0.00" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2.0 }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sft_agent_cost_usd_simulated_total or vector(0)",
          "legendFormat": "Total Simulated Cost (USD)",
          "refId": "A",
          "comment": "NOTE: sft_agent_cost_usd_simulated_total requires a Prometheus counter pushed via Pushgateway from BudgetSnapshot.cost_usd_simulated. Falls back to 0 when metric absent."
        }
      ],
      "title": "Total Simulated Cost (USD)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Simulated cost per agent cluster (USD). Each cluster (maintenance, supply, knowledge, monitoring) has independent BudgetLimits from budgets.yaml. Wired via Pushgateway labels: agent_cluster.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "USD",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 70,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "decimals": 4,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(sft_agent_cost_usd_simulated_total[5m])",
          "legendFormat": "{{agent_cluster}} cost rate",
          "refId": "A",
          "comment": "NOTE: Requires sft_agent_cost_usd_simulated_total counter with agent_cluster label pushed via Pushgateway."
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(events_published_total[5m]) * 0.0001",
          "legendFormat": "{{subject}} (proxy estimate)",
          "refId": "B",
          "comment": "Fallback: event rate * 0.0001 USD as rough cost proxy when Pushgateway metric absent."
        }
      ],
      "title": "Cost Rate per Agent Cluster (USD/s)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Token Consumption per Agent (OBS-07)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Input tokens consumed per agent cluster. BudgetSnapshot.tokens_input from sft_agents/models/budget.py (D-60). Wire via Pushgateway with label agent_cluster.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
