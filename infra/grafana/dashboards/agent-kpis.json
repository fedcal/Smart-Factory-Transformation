      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, job) (rate(ingest_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{job}}",
          "refId": "A"
        }
      ],
      "title": "Agent Latency p50 (Median)",
