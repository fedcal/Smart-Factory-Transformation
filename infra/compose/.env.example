# Smart Factory Transformation — Environment Variables Example
# ============================================================
# Questo file e' solo per dev locale; secrets prod gestiti via SealedSecrets (plan 06)
# NON committare il file .env reale — solo .env.example e' versionato (T-1-03)
#
# Setup:
#   cp infra/compose/.env.example .env
#   # Generare encryption key sicura:
#   export LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)
#   sed -i "s|LANGFUSE_ENCRYPTION_KEY=.*|LANGFUSE_ENCRYPTION_KEY=$LANGFUSE_ENCRYPTION_KEY|" .env
#
# Valori default contrassegnati con _dev_pass sono intenzionalmente weak
# per essere riconoscibili da secret scanner (gitleaks, plan 04).
# Sostituire TUTTI i valori <CHANGE_ME_IN_PROD> prima di qualsiasi deploy non-dev.

# -----------------------------------------------------------------------
# Core Services — Postgres + TimescaleDB
# -----------------------------------------------------------------------
POSTGRES_USER=sft
POSTGRES_PASSWORD=sft_dev_pass
POSTGRES_DB=sft
POSTGRES_PORT=5432

# -----------------------------------------------------------------------
# Core Services — Redis (cache core)
# -----------------------------------------------------------------------
REDIS_PORT=6379

# -----------------------------------------------------------------------
# Core Services — Qdrant (vector store)
# -----------------------------------------------------------------------
QDRANT_PORT=6333

# -----------------------------------------------------------------------
# Observability Stack — Langfuse v3 (Postgres dedicato, separato da core)
# -----------------------------------------------------------------------
LANGFUSE_PG_USER=langfuse
LANGFUSE_PG_PASSWORD=langfuse_dev_pass
LANGFUSE_PG_DB=langfuse

# LANGFUSE_NEXTAUTH_SECRET: deve essere almeno 32 caratteri in produzione
# Generare con: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=change_me_in_prod_32chars_minimum_<CHANGE_ME_IN_PROD>

# LANGFUSE_SALT: usato per hash di API key; deve essere unico per istanza
LANGFUSE_SALT=change_me_in_prod_salt_<CHANGE_ME_IN_PROD>

# LANGFUSE_ENCRYPTION_KEY: 64 hex chars (32 bytes) — generare con: openssl rand -hex 32
# CRITICO: ruotare immediatamente se esposta; non riutilizzare tra ambienti
# Generare con: export LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)
LANGFUSE_ENCRYPTION_KEY=<CHANGE_ME_IN_PROD_run_openssl_rand_hex_32>

LANGFUSE_PORT=3000

# -----------------------------------------------------------------------
# Observability Stack — ClickHouse (analytics per Langfuse)
# -----------------------------------------------------------------------
CLICKHOUSE_DB=langfuse
CLICKHOUSE_USER=langfuse
CLICKHOUSE_PASSWORD=langfuse_ch_dev_pass
CLICKHOUSE_PORT=8123

# -----------------------------------------------------------------------
# Observability Stack — MinIO (object storage per Langfuse traces)
# Nota licenza: MinIO e' AGPL-3.0; vedere LICENSE-EXCEPTIONS.md
# -----------------------------------------------------------------------
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=langfuse_minio_dev_pass
MINIO_PORT=9090

# -----------------------------------------------------------------------
# Simulation Stack — NATS JetStream
# -----------------------------------------------------------------------
NATS_PORT=4222
NATS_MONITORING_PORT=8222

# -----------------------------------------------------------------------
# LLM Stack — Ollama
# -----------------------------------------------------------------------
OLLAMA_PORT=11434

# Modello default da scaricare: qwen2.5:7b-instruct-q4_K_M (~4.7 GB)
# Alternativa leggera: qwen2.5:3b-instruct-q4_K_M (~2.3 GB)
# Scaricare con: docker exec -it <container_ollama> ollama pull qwen2.5:7b-instruct-q4_K_M
OLLAMA_MODEL_DEFAULT=qwen2.5:7b-instruct-q4_K_M

# -----------------------------------------------------------------------
# Phase 11 — Observability & Eval (Piano 11-05, SEC-05)
#
# Policy SEC-05: nessun secret reale in questo file — solo placeholder e commenti.
# Il secret guard di Phase 10 (jwt.py righe 38-53) è il pattern di riferimento:
# RuntimeError se API_SECRET_KEY assente e APP_ENV != dev/test/development.
# Replicare lo stesso pattern per ogni nuova secret (fail-fast in produzione).
# -----------------------------------------------------------------------

# OpenTelemetry — OTLP exporter verso Tempo (tracing distribuito)
# Consumato da: packages/sft-agents/src/sft_agents/otel/provider.py:setup_tracer_provider
# Default per docker-compose locale: http://tempo:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317

# Nome del servizio OTEL (label nei trace Langfuse / Grafana)
OTEL_SERVICE_NAME=sft-api-gateway

# -----------------------------------------------------------------------
# Grafana — dashboard observability (porta separata da Langfuse che occupa 3000)
# Nota: RESEARCH Pitfall 4 — Grafana su 3001 per evitare conflitto con Langfuse
# -----------------------------------------------------------------------
GRAFANA_PORT=3001

# -----------------------------------------------------------------------
# Langfuse API Keys — GENERARE per ogni istanza, non riutilizzare tra ambienti.
#
# Come generare:
#   1. Aprire Langfuse UI (http://localhost:3000)
#   2. Settings > API Keys > Create new key
#   3. Copiare Public Key e Secret Key nel file .env locale (NON in questo file)
#
# Formato: pk-lf-<uuid> / sk-lf-<uuid>
# ATTENZIONE: le chiavi iniziano con "pk-lf-" / "sk-lf-" — qualsiasi altro
# formato è probabilmente errato o una chiave di un altro servizio.
# -----------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=pk-lf-<GENERATE_IN_LANGFUSE_UI>
# LANGFUSE_SECRET_KEY=sk-lf-<GENERATE_IN_LANGFUSE_UI>
LANGFUSE_PUBLIC_KEY=pk-lf-placeholder-change-me
LANGFUSE_SECRET_KEY=sk-lf-placeholder-change-me

# -----------------------------------------------------------------------
# Eval gate — LLM reale vs deterministico CI
#
# Vuoto (default): usa MockDeepEvalLLM → gate deterministico CI, nessun costo.
# Impostare a "true" per eval con LLM reale (richiede LANGFUSE_* configurate).
# Vedere: tests/eval/test_rag_ci_gate.py
# -----------------------------------------------------------------------
EVAL_REAL_LLM=
