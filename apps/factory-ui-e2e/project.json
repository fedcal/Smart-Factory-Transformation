{
  "name": "ui-factory-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/factory-ui-e2e/src",
  "tags": ["e2e", "scope:factory-ui"],
  "implicitDependencies": ["ui-factory"],
  "targets": {
    "e2e": {
      "executor": "@nx/playwright:playwright",
      "outputs": [
        "{workspaceRoot}/dist/.playwright/apps/factory-ui-e2e"
      ],
      "options": {
        "config": "apps/factory-ui-e2e/playwright.config.ts"
      },
      "configurations": {
        "ci": {
          "ci": true,
          "reporter": "html"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
