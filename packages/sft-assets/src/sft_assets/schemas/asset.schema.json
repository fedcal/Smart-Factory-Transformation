{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sft-assets/schemas/asset.schema.json",
  "title": "SFT Asset",
  "description": "Schema Draft 2020-12 per un asset fisico della piattaforma tessile IT/OT (D-45). Valida registry.yaml entries.",
  "type": "object",
  "required": ["asset_id", "asset_family", "line_id", "opcua_namespace", "tags"],
  "additionalProperties": false,
  "properties": {
    "asset_id": {
      "type": "string",
      "pattern": "^[A-Z]+-\\d{2}$",
      "description": "Identificativo canonico dell'asset (es. LOOM-01, SPIN-08)"
    },
    "asset_family": {
      "type": "string",
      "enum": ["loom", "spinning", "warping", "dyeing", "finishing"],
      "description": "Famiglia dell'asset (D-21 + D-44) — 5 valori ammessi"
    },
    "line_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identificativo della linea produttiva"
    },
    "opcua_namespace": {
      "type": "string",
      "pattern": "^urn:mantis:",
      "description": "Namespace OPC-UA dell'asset — deve iniziare con urn:mantis: (T-03-01-pydantic)"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag_id", "unit", "sample_rate_hz", "semantic_type"],
        "additionalProperties": false,
        "properties": {
          "tag_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]+$",
            "description": "Identificativo canonico del tag (snake_case, lowercase)"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "description": "Unita' di misura (es. N, picks_per_cm, degC, rpm, bar)"
          },
          "sample_rate_hz": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1000,
            "description": "Frequenza di campionamento in Hz"
          },
          "semantic_type": {
            "type": "string",
            "enum": ["tension", "density", "temperature", "humidity", "vibration", "speed", "pressure", "flow", "ph", "level"],
            "description": "Tipo semantico del tag sensore — 10 valori canonici"
          }
        }
      },
      "description": "Definizioni dei tag sensore associati all'asset"
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "maintenance"],
      "default": "active",
      "description": "Stato operativo dell'asset"
    }
  }
}
