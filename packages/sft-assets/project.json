{
  "name": "sft-assets",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/sft-assets/src",
  "targets": {
    "test": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "packages/sft-assets"
      }
    },
    "lint": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run ruff check src",
        "cwd": "packages/sft-assets"
      }
    },
    "validate-registry": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "python3 ../../scripts/validate-asset-registry.py",
        "cwd": "."
      }
    }
  },
  "implicitDependencies": []
}
