{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sft-domain/glossary/schema.json",
  "title": "SFT Glossary Term",
  "description": "Schema per un termine del glossario bilingue (IT/EN) del dominio textile + agentic platform",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Term"
  },
  "$defs": {
    "Term": {
      "type": "object",
      "required": ["term", "definition", "category"],
      "additionalProperties": false,
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "description": "Nome canonic del termine (minuscolo, underscore per spazi nei compound)"
        },
        "definition": {
          "type": "string",
          "minLength": 10,
          "description": "Definizione del termine nel contesto textile/agentic"
        },
        "category": {
          "type": "string",
          "enum": [
            "textile-process",
            "textile-asset",
            "textile-defect",
            "textile-kpi",
            "textile-tool-ppe",
            "textile-material",
            "agentic-platform",
            "agentic-tool",
            "regulatory"
          ],
          "description": "Categoria tassonomica del termine (D-30)"
        },
        "related_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "Termini correlati nel glossario (snake_case)"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 5
          },
          "default": [],
          "description": "Esempi d'uso contestualizzati"
        },
        "source": {
          "type": "string",
          "enum": [
            "industry-standard",
            "iso-standard",
            "project-specific",
            "agentic-community"
          ],
          "default": "industry-standard",
          "description": "Fonte dell'autorita del termine"
        },
        "no_direct_equivalent": {
          "type": "boolean",
          "default": false,
          "description": "True se il termine non ha equivalente diretto nell'altra lingua (D-31)"
        }
      }
    }
  }
}
