{
  "name": "agents-scheduler",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "services/agents-scheduler/src",
  "targets": {
    "run": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run python -m svc_agents_scheduler",
        "cwd": "services/agents-scheduler"
      }
    },
    "test": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run pytest",
        "cwd": "services/agents-scheduler"
      }
    },
    "lint": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "uv run ruff check src",
        "cwd": "services/agents-scheduler"
      }
    },
    "docker-build": {
      "executor": "@nxlv/python:run-commands",
      "options": {
        "command": "docker build -f services/agents-scheduler/Dockerfile -t sft-agents-scheduler:dev .",
        "cwd": "."
      }
    }
  },
  "implicitDependencies": []
}
